{
  "name": "rebase-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "^1.0.16",
    "@react-native-ai/apple": "^0.12.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-material-icon-theme": "^1.2.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "bun run native:android && expo run:android",
    "ios": "bun run native:ios && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas-build-pre-install": "node scripts/eas-build-pre-install.mjs",
    "build:ios": "bunx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "bunx eas-cli@latest submit --platform ios --profile production",
    "update:beta": "bunx eas-cli@latest update --platform ios --channel beta --environment production",
    "native:ios": "node scripts/build-native-link.mjs ios",
    "native:android": "node scripts/build-native-link.mjs android"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
